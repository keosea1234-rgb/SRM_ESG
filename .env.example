# SRM — Environment Variables
# Copy this to .env and fill in your values

# Supabase (shared with ContractGuard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SUPABASE_JWT_SECRET is not used anymore (ES256/JWKS verification)

# Allowed frontend origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend (Vite prefix required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:3001

# Server
PORT=3001
APP_URL=http://localhost:5174
